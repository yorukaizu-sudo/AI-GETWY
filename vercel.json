{
  "version": 2,
  "functions": { "api/*.js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/v1?p=:path*" },
    { "source": "/chat/completions", "destination": "/api/v1?p=chat/completions" },
    { "source": "/admin/:path*", "destination": "/api/admin?p=:path*" },
    { "source": "/", "destination": "/api/v1?p=" }
  ]
}
